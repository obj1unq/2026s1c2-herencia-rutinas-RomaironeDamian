import gimnasia.*
import personas.*
import clubes.*

describe "rutinas" {

//Punto 1: rutinas
	const correrEnLaPlaya = new Running(intensidad = 1.2)// Una actividad de running con intensisdad 1.2
	const maratonBA = new Maraton(intensidad = 1.5)//Una maraton con intensidad 1.5
	const remarEnElDelta = new Remo()// Una actividad de remo
	const remarEnCaminoRemeros = new RemoCompeticion()// Una actividad de remo comptetitivo

	test "calcular calorias de running por la playa" {
		assert.equals(360, correrEnLaPlaya.calcularCalorias(5))
		assert.equals(10200, correrEnLaPlaya.calcularCalorias(90))
	}

	test "calcular calorias de Maraton en BA" {
		assert.equals(900, maratonBA.calcularCalorias(5))
		assert.equals(25500, maratonBA.calcularCalorias(90))
	}

	test "calcular calorias de Remo en el Delta" {
		assert.equals(520, remarEnElDelta.calcularCalorias(5))
		assert.equals(9360, remarEnElDelta.calcularCalorias(90))
	}

	test "calcular calorias de Remo en caminos remeros" {
		assert.equals(510, remarEnCaminoRemeros.calcularCalorias(5))
		assert.equals(12750, remarEnCaminoRemeros.calcularCalorias(90))
	}
}

//Punto 2: personas
describe "Personas" {
	const correrEnLaPlaya = new Running(intensidad = 1.2)// Una actividad de running con intensisdad 1.2
	const maratonBA = new Maraton(intensidad = 1.5)//Una maraton con intensidad 1.5
	const remarEnElDelta = new Remo()// Una actividad de remo
	const remarEnCaminoRemeros = new RemoCompeticion()// Una actividad de remo comptetitivo

	const calamardo = new PersonaSedentaria(peso = 60, tiempoPorRutina = 5) // Una persona Sedentaria con peso 60 y tiempo de ejercicio 5
	const bob = new PersonaAtleta(peso = 40) // Una persona atleta con peso 40 

  test "calamardo corre en la playa" {
	assert.equals(60, calamardo.peso())
	calamardo.perderPeso(correrEnLaPlaya)
	assert.equals(59.948, calamardo.peso().truncate(3))
  }

  test "calamardo corre en la maraton de BA" {
	assert.equals(60, calamardo.peso())
	calamardo.perderPeso(maratonBA)
	assert.equals(59.871, calamardo.peso().truncate(3))
  }

  test "calamardo rema en el delta" {
	assert.equals(60, calamardo.peso())
	calamardo.perderPeso(remarEnElDelta)
	assert.equals(59.925, calamardo.peso().truncate(3))
  }

  test "calamardo rema en caminos remeros" {
	assert.equals(60, calamardo.peso())
	calamardo.perderPeso(remarEnCaminoRemeros)
	assert.equals(59.927, calamardo.peso().truncate(3))
  }

    test "bob corre en la playa" {
	assert.equals(40, bob.peso())
	bob.perderPeso(correrEnLaPlaya)
	assert.equals(39.725, bob.peso().truncate(3))
  }

  test "bob corre en la maraton de BA" {
	assert.equals(40, bob.peso())
	bob.perderPeso(maratonBA)
	assert.equals(37.812, bob.peso().truncate(3))
  }

  test "bob rema en el delta" {
	assert.equals(40, bob.peso())
	bob.perderPeso(remarEnElDelta)
	assert.equals(40, bob.peso().truncate(3))
  }

  test "bob rema en caminos remeros" {
	assert.equals(40, bob.peso())
	bob.perderPeso(remarEnCaminoRemeros)
	assert.equals(39.406, bob.peso().truncate(3))
  }
}

//Punto 3: clubes
describe "clubes" {
	const correrEnLaPlaya = new Running(intensidad = 1.2)// Una actividad de running con intensisdad 1.2
	const maratonBA = new Maraton(intensidad = 1.5)//Una maraton con intensidad 1.5
	const remarEnElDelta = new Remo()// Una actividad de remo
	const remarEnCaminoRemeros = new RemoCompeticion()// Una actividad de remo comptetitivo

	const calamardo = new PersonaSedentaria(peso = 60, tiempoPorRutina = 5) // Una persona Sedentaria con peso 60 y tiempo de ejercicio 5
	const bob = new PersonaAtleta(peso = 40) // Una persona atleta con peso 40 

	const recreo = new Predio(rutinas = [correrEnLaPlaya, maratonBA])//un predio con correrEnLaPlaya y maratonBA
	const nautico = new Predio(rutinas = [remarEnElDelta, remarEnCaminoRemeros]) //un predio con remarEnElDelta y remarEnCaminoRemeros
	const clubBarrial = new Club(predios = [recreo, nautico]) //un club con recreo y nautico
  test "mejor predio para Bob" {
	assert.equals(recreo, clubBarrial.mejorPredio(bob))
  }

  test "mejor predio para Calamardo" {
	assert.equals(recreo, clubBarrial.mejorPredio(calamardo))
  }
}